# Copy to .env. These local-only values are placeholders, never production credentials.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-postgres-superuser
APP_DATABASE_USER=app_runtime
APP_DATABASE_PASSWORD=change-me-app-database
APP_DATABASE_NAME=food_ordering_app
PROVIDER_DATABASE_USER=provider_runtime
PROVIDER_DATABASE_PASSWORD=change-me-provider-database
PROVIDER_DATABASE_NAME=food_ordering_provider
APP_DATABASE_URL=postgres://app_runtime:change-me-app-database@postgres:5432/food_ordering_app
PROVIDER_DATABASE_URL=postgres://provider_runtime:change-me-provider-database@postgres:5432/food_ordering_provider
PROVIDER_SERVICE_TOKEN=local-development-provider-token-replace-before-sharing
PROVIDER_BASE_URL=http://mock-provider:8081
PROVIDER_CALLBACK_URL=http://api:8080/webhooks/mock-payments
PROVIDER_CALLBACK_SIGNING_SECRET=local-development-callback-signing-secret-replace-before-sharing
